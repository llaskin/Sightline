# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. The example is deliberately committed: setup.md and the README
# both tell you to copy it, so ignoring it would break a fresh checkout.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env
.env.local
.env

# test output
/test-results/
/playwright-report/
/blob-report/
/tests/e2e/.auth/
/docs/verification-artifacts/*.png

# Playwright saved sessions
tests/e2e/.auth/

# Regenerable knowledge graph (graphify update .)
graphify-out/
