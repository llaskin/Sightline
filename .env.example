# Copy to `.env.local` and adjust. Never commit real secrets.
# All values below are non-secret local development examples.

# Development database (docker compose up -d publishes PostgreSQL on 5433).
DATABASE_URL=postgres://excuse:sightline_local_dev@localhost:5433/sightline

# Isolated database used only by `npm run test:integration`.
# The integration harness asserts this name ends in `_test` and never falls
# back to DATABASE_URL. Destructive truncation runs against it.
TEST_DATABASE_URL=postgres://excuse:sightline_local_dev@localhost:5433/sightline_test

# Isolated database used only by `npm run test:e2e`, which resets and reseeds
# it. Kept separate from both of the above so a browser run cannot destroy
# local development data or race the integration suite.
E2E_DATABASE_URL=postgres://excuse:sightline_local_dev@localhost:5433/sightline_e2e

# Session signing secret. Generate a real one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-value

# Public base URL of this application.
BETTER_AUTH_URL=http://localhost:3100

# Origin allowed to submit state-changing requests (same-origin enforcement).
APP_ORIGIN=http://localhost:3100

# Public source URL, shown as a "Source" link in the footer.
# AGPL-3.0 section 13 requires offering source to anyone who uses this over a
# network, so set this to your public repository before deploying. Left unset,
# the link is omitted rather than pointing somewhere untrue.
# NEXT_PUBLIC_SOURCE_URL=https://github.com/<owner>/sightline

# Release 1 requires no Google credentials and no AI provider key.
